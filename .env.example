# Salin menjadi .env.local lalu isi nilainya. JANGAN commit .env.local.

# --- LLM (Claude API) — dipakai mulai Fase 2 ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# --- Embedding (Voyage AI) ---
EMBEDDING_API_KEY=
EMBEDDING_MODEL=voyage-4
# Harus sama dengan dimensi kolom chunks.embedding di migrasi (default 1024)
EMBEDDING_DIMENSIONS=1024

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hanya dipakai di server/skrip. Jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Eskalasi & pembatasan ---
HR_WHATSAPP_NUMBER=6281234567890   # nomor dummy untuk demo; format internasional tanpa +
RATE_LIMIT_PER_HOUR=20
